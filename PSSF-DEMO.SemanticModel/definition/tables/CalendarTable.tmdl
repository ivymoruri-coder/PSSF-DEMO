		sourceColumn: [Year Quarter Number]

		annotation SummarizationSetBy = Automatic

	partition CalendarTable = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR(DATE(2020, 1, 1), DATE(2026, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "mmmm"),
				    "Month Short", FORMAT([Date], "mmm"),
				    "Day of Week Number", WEEKDAY([Date], 2), -- 1 = Monday, 7 = Sunday
				    "Day of Week", FORMAT([Date], "dddd"),
				    "Year Month", FORMAT([Date], "mmm yyyy"),
				    "Year Month Number", YEAR([Date]) * 100 + MONTH([Date]),
				    "Year Quarter", "Q" & FORMAT([Date], "Q") & " " & YEAR([Date]),
				    "Year Quarter Number", YEAR([Date]) * 10 + INT(FORMAT([Date], "Q"))
				)

	annotation PBI_Id = 8d3740e9d1234192b88cc5d5de2b4809

